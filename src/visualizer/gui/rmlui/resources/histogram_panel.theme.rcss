/* Histogram panel theme overrides. */

#histogram-header {
    border-color: @{border};
}

.dock-drag-handle-bar {
    background-color: @{alpha(text_dim,0.63)};
}

.dock-drag-handle:hover .dock-drag-handle-bar {
    background-color: @{alpha(primary,0.86)};
}

#histogram-controls {
    border-color: @{border};
}

#histogram-controls .histogram-select {
    background-color: @{surface};
    border-color: @{border};
}

.histogram-control-group--advanced,
#histogram-stats,
.histogram-range-toolbar,
#histogram-footer {
    border-color: @{border};
}

#histogram-chart,
#compare-chart {
    background-color: @{panel.histogram_chart_bg};
    border-color: @{border};
}

.histogram-grid-line {
    background-color: @{panel.histogram_grid};
}

.histogram-range-toolbar {
    border-color: @{border};
}

.histogram-chip {
    color: @{primary};
    background-color: transparent;
    border-color: @{alpha(primary,0.55)};
}

.histogram-context-label,
.histogram-metric__label,
.footer-label,
.axis-metric,
.histogram-description,
.empty-message,
.footer-hint,
.range-separator {
    color: @{text_dim};
}

.histogram-title,
.histogram-metric__value,
#histogram-summary,
#compare-summary,
.axis-label,
.footer-value,
#histogram-floating-title,
.empty-title,
.histogram-slider-value {
    color: @{text};
}

.histogram-metric--primary .histogram-metric__value {
    color: @{primary};
}

.compare-axis-marker {
    color: @{text_dim};
}

.histogram-metric + .histogram-metric {
    border-color: @{border};
}

.histogram-bar-fill,
.compare-cell-fill {
    @{panel.histogram_fill_decor};
}

.histogram-bar.selected .histogram-bar-fill,
.compare-cell.selected .compare-cell-fill {
    @{panel.histogram_fill_selected_decor};
}

#histogram-selection,
#compare-selection {
    border-color: @{warning};
    background-color: @{panel.histogram_selection_fill};
    decorator: none;
}

.histogram-history-btn:disabled .histogram-history-icon {
    image-color: @{panel.histogram_history_icon_disabled};
}

.footer-history-actions {
    border-color: transparent;
}
