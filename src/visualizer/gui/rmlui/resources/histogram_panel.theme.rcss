/* Histogram panel theme overrides. */

#histogram-header {
    @{panel.histogram_hero_decor};
    border-color: @{border};
}

.dock-drag-handle-bar {
    background-color: @{alpha(text_dim,0.63)};
}

.dock-drag-handle:hover .dock-drag-handle-bar {
    background-color: @{alpha(primary,0.86)};
}

#histogram-controls {
    background-color: @{panel.histogram_toolbar_item};
    border-color: @{panel.histogram_toolbar_divider};
}

#histogram-controls .histogram-select {
    background-color: @{panel.histogram_toolbar_select};
    border-color: @{panel.histogram_toolbar_divider};
}

.stat-card,
#histogram-card,
#compare-card,
.empty-card,
#histogram-footer {
    background-color: @{panel.histogram_surface};
    border-color: @{border};
}

#histogram-chart,
#compare-chart {
    background-color: @{panel.histogram_chart_bg};
    border-color: @{border};
}

.histogram-grid-line {
    background-color: @{panel.histogram_grid};
}

.histogram-range-toolbar {
    background-color: @{panel.histogram_toolbar_item};
    border-color: @{panel.histogram_toolbar_divider};
}

.histogram-chip {
    color: @{primary};
    background-color: @{panel.primary_bg_soft};
    border-color: @{panel.primary_border_soft};
}

.histogram-eyebrow,
.histogram-control-label,
.stat-label,
.footer-label,
.axis-metric,
.histogram-description,
.empty-message,
.footer-hint,
.range-separator {
    color: @{text_dim};
}

.histogram-title,
.stat-value,
#histogram-summary,
#compare-summary,
.axis-label,
.footer-value,
#histogram-floating-title,
.empty-title,
.histogram-slider-value {
    color: @{text};
}

.compare-axis-marker {
    color: @{text_dim};
}

.stat-card--primary {
    border-color: @{panel.primary_border_soft};
}

.histogram-bar-fill,
.compare-cell-fill {
    @{panel.histogram_fill_decor};
}

.histogram-bar.selected .histogram-bar-fill,
.compare-cell.selected .compare-cell-fill {
    @{panel.histogram_fill_selected_decor};
}

#histogram-selection,
#compare-selection {
    border-color: @{warning};
    background-color: @{panel.histogram_selection_fill};
    decorator: none;
}

.histogram-history-btn:disabled .histogram-history-icon {
    image-color: @{panel.histogram_history_icon_disabled};
}

.footer-history-actions {
    background-color: @{panel.histogram_footer_chip};
    border-color: @{panel.histogram_toolbar_divider};
}
