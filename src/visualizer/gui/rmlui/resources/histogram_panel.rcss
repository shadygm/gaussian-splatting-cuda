/* Histogram panel — panel-specific layout only.
 * Shared controls, typography, and theme colors live in components.rcss and
 * histogram_panel.theme.rcss. Keep this file focused on structure so the
 * panel follows the same window language in every theme and docking mode. */

body {
    font-family: Inter;
    padding: 0;
    bottom: 0;
}

#content-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
    padding: 6dp;
    overflow: hidden;
}

#content {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

/* The drag affordance is the same compact handle used by other resizable
 * bottom-dock panels. */
.dock-drag-handle {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    height: 8dp;
    padding-top: 3dp;
}

.dock-drag-handle-bar {
    width: 36dp;
    height: 3dp;
    border-radius: 2dp;
}

.dock-drag-handle.hidden,
.hidden {
    display: none;
}

#histogram-shell {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6dp;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

#histogram-shell.is-floating {
    padding-top: 4dp;
}

#histogram-floating-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 auto;
    min-height: 28dp;
    gap: 8dp;
    padding: 0 4dp;
}

#histogram-floating-title {
    min-width: 0;
    font-size: 12dp;
    font-weight: 600;
}

.histogram-window-actions,
.histogram-heading-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 0 auto;
    gap: 6dp;
}

.histogram-window-action {
    min-width: 64dp;
    min-height: 26dp;
}

/* Header and toolbar are one compact window chrome unit. The header carries
 * context; the toolbar carries the controls without duplicating a second
 * floating-only control tree. */
#histogram-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 auto;
    min-width: 0;
    min-height: 58dp;
    gap: 16dp;
    padding: 10dp 12dp;
    border-width: 1dp;
    border-radius: 8dp 8dp 0 0;
}

.histogram-heading {
    display: flex;
    flex: 1 1 240dp;
    flex-direction: column;
    min-width: 0;
    gap: 2dp;
}

.histogram-eyebrow,
.histogram-control-label,
.stat-label,
.footer-label,
.axis-metric {
    font-size: 11dp;
    letter-spacing: 0.25dp;
    text-transform: uppercase;
}

.histogram-title {
    min-width: 0;
    overflow: hidden;
    font-size: 15dp;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.histogram-description {
    min-width: 0;
    overflow: hidden;
    font-size: 12dp;
    line-height: 16dp;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#histogram-controls {
    display: flex;
    align-items: flex-end;
    flex: 0 0 auto;
    flex-wrap: wrap;
    gap: 8dp 10dp;
    min-width: 0;
    padding: 8dp 10dp 9dp;
    border-width: 1dp;
    border-top-width: 0;
    border-radius: 0 0 8dp 8dp;
}

.histogram-control-block {
    display: flex;
    flex: 1 1 170dp;
    flex-direction: column;
    min-width: 126dp;
    gap: 3dp;
}

.histogram-control-block--select {
    flex-basis: 180dp;
}

.histogram-control-block--toggle {
    flex: 0 1 96dp;
    min-width: 84dp;
}

.histogram-control-block--slider {
    flex-basis: 164dp;
}

.histogram-control-label {
    font-weight: 600;
}

.histogram-select {
    width: 100%;
    min-width: 0;
    height: 24dp;
    min-height: 24dp;
}

.histogram-slider-row {
    display: flex;
    align-items: center;
    min-width: 0;
    height: 24dp;
    gap: 6dp;
}

.histogram-setting-slider {
    flex: 1;
    min-width: 60dp;
    margin-top: 0;
    position: static;
    top: auto;
}

.histogram-slider-value {
    display: inline-block;
    flex: 0 0 30dp;
    min-width: 30dp;
    text-align: right;
    font-family: "JetBrains Mono";
    font-size: 12dp;
}

.histogram-toggle-control {
    display: flex;
    align-items: center;
    min-height: 24dp;
}

.histogram-toggle-control input[type="checkbox"] {
    margin: 0;
}

#histogram-empty {
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 0;
}

.empty-card {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 180dp;
    gap: 6dp;
    padding: 18dp;
    border-width: 1dp;
    border-radius: 8dp;
    text-align: center;
}

.empty-title {
    font-size: 14dp;
    font-weight: 600;
}

.empty-message {
    max-width: 440dp;
    font-size: 12dp;
    line-height: 17dp;
}

#histogram-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    gap: 8dp;
    overflow-x: hidden;
    overflow-y: auto;
    padding-right: 2dp;
}

#histogram-stats {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    min-width: 0;
    gap: 6dp;
}

.stat-card {
    display: flex;
    flex: 1 1 112dp;
    flex-direction: column;
    min-width: 104dp;
    min-height: 48dp;
    gap: 3dp;
    padding: 7dp 9dp;
    border-width: 1dp;
    border-radius: 7dp;
}

.stat-card--primary {
    flex-basis: 120dp;
}

.stat-value {
    min-width: 0;
    overflow: hidden;
    font-size: 14dp;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.stat-value--small {
    font-size: 12dp;
}

#histogram-card,
#compare-card {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    gap: 8dp;
    padding: 10dp;
    border-width: 1dp;
    border-radius: 8dp;
}

#compare-card {
    min-height: 320dp;
}

.histogram-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 auto;
    min-width: 0;
    gap: 10dp;
}

#histogram-summary,
#compare-summary {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 12dp;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.histogram-chip {
    flex: 0 0 auto;
    padding: 2dp 7dp;
    border-width: 1dp;
    border-radius: 999dp;
    font-size: 11dp;
    letter-spacing: 0.2dp;
    text-transform: uppercase;
}

.histogram-range-toolbar {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    flex-wrap: wrap;
    min-width: 0;
    gap: 6dp;
    padding: 6dp 7dp;
    border-width: 1dp;
    border-radius: 6dp;
}

.range-of-interest-label {
    flex: 0 0 auto;
    margin-right: 2dp;
    font-size: 12dp;
    font-weight: 600;
}

.range-input {
    flex: 0 1 96dp;
    width: 96dp;
    min-width: 72dp;
    height: 24dp;
    min-height: 24dp;
    font-family: "JetBrains Mono";
}

.range-separator {
    flex: 0 0 auto;
    font-size: 12dp;
}

.range-reset {
    flex: 0 0 auto;
    min-width: 56dp;
    min-height: 24dp;
    margin-left: 2dp;
}

.range-reset:disabled {
    opacity: 0.45;
}

.compare-axis-marker {
    flex: 0 0 auto;
    margin-left: 3dp;
    font-size: 11dp;
    font-weight: 700;
    letter-spacing: 0.4dp;
}

#histogram-chart,
#compare-chart {
    position: relative;
    flex: 1;
    min-width: 0;
    min-height: 148dp;
    overflow: hidden;
    border-width: 1dp;
    border-radius: 7dp;
}

.histogram-grid-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1dp;
    pointer-events: none;
}

.histogram-grid-line--top-16 {
    top: 16%;
}

.histogram-grid-line--top-36 {
    top: 36%;
}

.histogram-grid-line--top-56 {
    top: 56%;
}

.histogram-grid-line--top-76 {
    top: 76%;
}

#histogram-bars {
    position: absolute;
    top: 12dp;
    right: 12dp;
    bottom: 12dp;
    left: 12dp;
    display: flex;
    align-items: flex-end;
    min-width: 0;
    cursor: crosshair;
}

#histogram-selection {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 2dp;
    border-width: 1dp;
    border-radius: 5dp;
    pointer-events: none;
}

.histogram-bar {
    position: relative;
    display: flex;
    align-items: flex-end;
    flex: 1;
    min-width: 0;
    height: 100%;
}

.histogram-bar-fill {
    width: 100%;
    min-height: 1dp;
    border-radius: 999dp 999dp 3dp 3dp;
}

#histogram-axis,
#compare-axis {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 auto;
    min-width: 0;
    gap: 10dp;
}

.axis-label {
    min-width: 0;
    overflow: hidden;
    font-family: "JetBrains Mono";
    font-size: 11dp;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#compare-empty {
    display: flex;
    flex: 1;
    min-height: 0;
}

.compare-empty-card {
    min-height: 200dp;
}

#compare-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    gap: 8dp;
}

#compare-chart-shell {
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 260dp;
    gap: 8dp;
}

#compare-y-axis {
    display: flex;
    flex: 0 0 78dp;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    min-width: 0;
    padding: 2dp 0 20dp;
    gap: 8dp;
}

#compare-y-axis-values {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    width: 100%;
    min-width: 0;
}

#compare-chart-column {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    gap: 6dp;
}

#compare-chart {
    min-height: 236dp;
}

#compare-cells {
    position: absolute;
    top: 12dp;
    right: 12dp;
    bottom: 12dp;
    left: 12dp;
    min-width: 0;
    min-height: 0;
    cursor: crosshair;
}

#compare-selection {
    position: absolute;
    min-width: 2dp;
    min-height: 2dp;
    border-width: 1dp;
    border-radius: 5dp;
    pointer-events: none;
}

.compare-cell {
    position: absolute;
    top: 0%;
    left: 0%;
    width: 0%;
    height: 0%;
    box-sizing: border-box;
    padding: 1dp;
}

.compare-cell-fill {
    width: 100%;
    height: 100%;
    min-width: 1dp;
    min-height: 1dp;
    border-radius: 3dp;
}

#histogram-footer {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    flex-wrap: wrap;
    min-width: 0;
    min-height: 48dp;
    gap: 10dp;
    padding: 8dp 10dp;
    border-width: 1dp;
    border-radius: 8dp;
}

.footer-selection-stat {
    display: flex;
    flex: 0 1 132dp;
    flex-direction: column;
    min-width: 112dp;
    gap: 2dp;
}

.footer-value {
    min-width: 0;
    overflow: hidden;
    font-family: "JetBrains Mono";
    font-size: 11dp;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.footer-hint {
    flex: 1 1 180dp;
    min-width: 140dp;
    font-size: 11dp;
    line-height: 15dp;
}

.footer-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 0 auto;
    flex-wrap: wrap;
    gap: 8dp;
}

.footer-history-actions,
.footer-text-actions {
    display: flex;
    align-items: center;
    gap: 6dp;
}

.footer-history-actions {
    padding: 2dp;
    border-width: 1dp;
    border-radius: 6dp;
}

.histogram-history-btn {
    width: 28dp;
    min-width: 28dp;
    height: 28dp;
    min-height: 28dp;
    padding: 0;
    border-radius: 5dp;
}

.histogram-history-icon {
    display: block;
    width: 15dp;
    height: 15dp;
    margin: 6dp auto 0;
}

.footer-text-action {
    min-width: 68dp;
    min-height: 28dp;
}

#histogram-floating-header.hidden,
#histogram-heading-actions.hidden,
#histogram-empty.hidden,
#histogram-content.hidden,
#histogram-card.hidden,
#compare-card.hidden,
#compare-empty.hidden,
#compare-content.hidden,
#histogram-selection.hidden,
#compare-selection.hidden,
.histogram-control-block.hidden,
.hidden {
    display: none;
}
